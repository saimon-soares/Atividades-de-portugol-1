programa
{
	
	funcao inicio()
	{
		inteiro num
		escreva("Digite um numero: ")
		leia(num)
		escolha(num){
			caso 1: escreva("um")
			pare
			caso 2: escreva("dois")
			pare
			caso 3: escreva("três")
			pare
			caso 4: escreva("quatro")
			pare
			caso 5: escreva("cinco")
			pare
			caso 67: escreva("sixseven")
			pare
			caso contrario: escreva("simo")
		}	
	}	
}
