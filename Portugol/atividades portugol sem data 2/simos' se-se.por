programa
{
	
	funcao inicio()
	{
		real N
		escreva("escreva um número: ")
		leia(N)
		se(N <= 10){
			escreva("f1")
		}senao{
			se(N <= 100){
				escreva("f2")
			}senao{
				escreva("f3")
			}
		}
	}
}
