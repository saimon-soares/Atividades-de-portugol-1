programa
{
	
	funcao inicio()
	{
		real numero
		escreva("escreva um número: ")
		leia(numero)
		se(numero >= 0){
			escreva("seu número é positivo")
		}
		senao{
			escreva("seu número é negativo")
		}
	}
}
