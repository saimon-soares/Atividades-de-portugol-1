programa
{
	
	funcao inicio()
	{
		real a,b
   		 
   		escreva("digite dois simos: ")
    		leia(a)
    		leia(b)
    		
    		escreva("a soma de ",a,"+",b," é igual a ",a+b) // Soma os dois valores
    		escreva("\na subtração de ",a,"-",b," é igual a ",a-b) // Subtrai os dois valores
    		escreva("\na multiplicação de ",a,"*",b," é igual a ",a*b) // Multiplica os dois valores
    		escreva("\na divisão de ",a,"/",b," é igual a ",a/b) // Divide os dois valores
    		escreva("\n\nsimo")
    		
	}
}
