programa
{
	
	funcao inicio()
	{
		inteiro anoa, anon 
		escreva("em que ano você nasceu: ")
		leia(anon)
		escreva("em que ano estamos? ")
		leia(anoa)
		escreva("a sua idade é: ",anoa-anon)

		escreva("\n\n\nseu nome é simo")
		
	}
}
