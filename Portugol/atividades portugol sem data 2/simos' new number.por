programa
{
	
	funcao inicio()
	{
		real numero
		escreva("escreva um número: ")
		leia(numero)
		se(numero >= 0){
			escreva("seu novo número é ",numero * 2)
		}senao{escreva("seu novo número é ",numero * 3)}
	}
}
