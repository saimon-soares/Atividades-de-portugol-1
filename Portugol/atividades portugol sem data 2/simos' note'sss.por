programa
{
	
	funcao inicio()
	{
		cadeia a
		real b,c,d,media
		
		escreva("fale o nome de um aluno: ")
		leia(a)
		escreva("agora fale as 3 notas deste aluno: ")
		leia(b)
		leia(c)
		leia(d)
		media = (c+b+d)/3
		escreva("a média de ",a," é de: ",media)
	
		
	}
}
