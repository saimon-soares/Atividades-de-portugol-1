programa
{
	
	funcao inicio()
	{
		real b, a, A
		escreva("digite a base do triangulo: ")
		leia(b)
		escreva("digite a altura do triangulo: ")
		leia(a)
		A = (b*a)/2
		escreva("a aura do seu triangulo é: ",A)



		escreva("\n\n\nI am simo")
	}
}
