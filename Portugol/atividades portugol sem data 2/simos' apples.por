programa
{
	
	funcao inicio()
	{
		real maca
		escreva("quantos maçãs você vai comprar? ")
		leia(maca)
		se(maca > 12){
			escreva("vai custar: ",maca," reais")
		}
		senao{
			escreva("vai custar: ",maca*1.30," reais")
		}
	}
}
