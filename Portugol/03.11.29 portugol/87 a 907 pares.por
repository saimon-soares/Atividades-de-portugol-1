programa
{
	
	
	funcao inicio()
	{
		inteiro x, p=0
		para(x=85;x>=87 e x<=907;x++){
			se(x % 2 == 0){
				escreva("\n",x)
				p = x + p
			}
		}escreva("\na soma de todos os números pares é: ",p)
	}
}

